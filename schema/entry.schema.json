{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KAI plugin registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "version",
    "apiVersion",
    "minCoreVersion",
    "repository",
    "url",
    "publicKey",
    "fingerprint",
    "sha256",
    "permissions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
    },
    "apiVersion": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "minCoreVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$",
      "description": "Foundation API 3 entries require 0.7.0 or later; older versions are archive metadata only."
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Immutable GitHub release URL: https://github.com/{repository}/releases/download/v{version}/{asset}.kaiplugin"
    },
    "publicKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{59}=$",
      "description": "Base64 DER SPKI Ed25519 public key"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "API 3: domain-separated SHA256 binding decoded-file signing payload, publisher key and signature. Archived API 1/2: SHA256 of canonical complete signed package JSON."
    },
    "permissions": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-zA-Z0-9-]*$"
      }
    }
  }
}
