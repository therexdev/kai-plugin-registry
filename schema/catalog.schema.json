{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KAI plugin registry catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "sequence",
    "generatedAt",
    "expiresAt",
    "plugins"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "Later than generatedAt, no more than366days after; UTC ISOmilliseconds"
    },
    "plugins": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "entry.schema.json"
      }
    }
  }
}
